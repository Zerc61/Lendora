APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Dipakai config/app.php ('timezone' => env('APP_TIMEZONE', 'Asia/Jakarta')).
# Nilai ini mengubah cara aplikasi menginterpretasikan/memformat waktu;
# data timestamp tetap disimpan sebagai UTC di PostgreSQL.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Driver WAJIB sama dengan produksi: PostgreSQL. Backup dari Aiven/MySQL pernah
# ikut ter-salin ke sini (padahal DB-nya sudah pindah ke Neon), dan itu membuat
# orang menulis SQL MySQL yang gagal 500 di produksi.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lendora
DB_USERNAME=lendora_user
DB_PASSWORD=

# TLS ke database. Kosongkan untuk memakai default config/database.php:
# `prefer` kalau APP_ENV=local, `require` untuk semua env lain. Neon menolak
# koneksi tanpa TLS, dan `prefer` bisa diam-diam jatuh ke plaintext bila
# server tidak menawarkan TLS — jangan dipaksa `prefer` di produksi.
# DB_SSLMODE=require

# Verifikasi sertifikat penuh (lebih ketat dari `require`):
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=system
# Butuh image punya paket ca-certificates, kalau tidak aplikasi gagal boot.

# Batas waktu koneksi, detik. Default 5. Tanpa ini PDO::connect() yang
# menggantung bisa menahan request sampai 60 detik.
# DB_CONNECT_TIMEOUT=5

# Label koneksi di pg_stat_activity, biar jelas mana yang aplikasi Lendora.
# DB_APPLICATION_NAME=lendora

# Neon opsional lewat URL. Kalau diisi, nilai host/port/database/user/password
# di atas DIABAIKAN — jangan isi keduanya.
# DB_URL=postgres://user:password@host/dbname?sslmode=require


SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Disk storage default. Lokal: `public` (diserve lewat symlink public/storage).
# Produksi (Vercel): set `s3` agar unggahan tidak hilang tiap deploy — lihat
# docs/deployment.md §10.4. Foto & lampiran TIDAK boleh memakai `local`.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Produksi (container / Vercel) ---------------------------------------------
# Catatan: tidak ada ASSET_VERSION. Cache busting CSS/JS memakai filemtime()
# per file di partials/head.blade.php, jadi otomatis berubah tiap edit.

# Di belakang reverse proxy (Vercel / Nginx / Cloudflare), Laravel harus
# mempercayai proxy agar X-Forwarded-Proto terbaca.
# Nilai: "*" untuk mempercayai semua, atau daftar IP/CIDR dipisah koma.
# JANGAN diisi "*" kalau aplikasi bisa diakses langsung tanpa proxy.
#
# Diperlukan BERSAMA SESSION_SECURE_COOKIE=true, dan dua-duanya tidak bisa
# saling menggantikan. Diperiksa dengan request http:// yang membawa
# X-Forwarded-Proto: https (persis kondisi di Vercel, karena hop internal
# Vercel → container itu plain HTTP):
#
#   TRUSTED_PROXIES kosong -> $request->secure() = FALSE
#   TRUSTED_PROXIES=*     -> $request->secure() = true
#
# Kalau TRUSTED_PROXIES kosong tapi SESSION_SECURE_COOKIE=true, cookie sesi
# tidak pernah dikirim balik -> user terjebak di halaman login selamanya.
# Lokal (php artisan serve) tidak lewat proxy, jadi biarkan kosong.
TRUSTED_PROXIES=

# Cookie sesi hanya lewat HTTPS. WAJIB "true" di produksi.
SESSION_SECURE_COOKIE=false

# Naikkan LOG_LEVEL (lihat atas) dari "debug" ke "warning" di produksi.

