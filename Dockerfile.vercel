# syntax=docker/dockerfile:1
#
# Lendora — image container untuk Vercel.
#
# Mengikuti pola resmi Vercel untuk Laravel + FrankenPHP, dengan penyesuaian:
#
#   TIDAK ADA stage frontend. Proyek ini sengaja tanpa build step — seluruh UI
#   adalah CSS/JS tulis-tangan yang dilayani langsung dari public/assets/
#   (public/assets/lendora.css & lendora.js, dimuat di partials/head.blade.php).
#   Tidak ada view memakai @vite (0 match di resources/views + app/), dan
#   `npm run build` hanya menghasilkan public/build yang tidak pernah dirujuk
#   siapa pun. Karena itu image ini TIDAK menjalankan npm sama sekali.
#   (package-lock.json sebenarnya ADA di repo — 2.503 baris. Yang tidak ada
#   adalah view yang memakainya. Jalankan `npm run build` di lokal hanya menambah
#   public/build yang tidak dirujuk; lihat PERF.md §Vite.)
#
# Yang TIDAK boleh ada di sini:
#   - COPY .env*            → kredensial masuk image & GitHub
#   - php artisan migrate   → beberapa instance bisa start bersamaan; migration
#                             dijalankan terpisah (docs/deployment.md §10.3)
#   - php artisan config:cache → mengunci env build-time ke dalam image, padahal
#                             Vercel menyuntikkan env saat runtime

# ============================================================
# Base — runtime + toolchain
# ============================================================
FROM dunglas/frankenphp:1-php8.4-bookworm AS base

# php.ini-production: memory_limit & error reporting sesuai produksi.
# pdo_pgsql, bukan pdo_mysql: database produksi Lendora adalah Neon
# PostgreSQL (docs/deployment.md §10.2). Tanpa ekstensi ini seluruh aplikasi
# gagal boot dengan "could not find driver" — bukan hanya halaman tertentu.
# app/ juga memakai SQL khusus PostgreSQL (EXTRACT(EPOCH …), TO_CHAR), jadi
# MySQL bukan hanya soal ekstensi — query-nya juga tidak akan jalan.
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions \
        pdo_pgsql \
        intl \
        gd \
        exif \
        bcmath \
        opcache \
        zip

# Opcache diberi setelan produksi yang SERIUS.
#
# Alasannya: opcache yang aktif/default saja menyimpan ~128MB opcode, tapi
# setting ini tetap ditulis eksplisit karena tiga hal:
#   1. validate_timestamps=0 + revalidate_freq=0 → PHP tidak perlu stat() file
#      tiap include. Di image container yang read-only, stat ini murni
#      pemborosan; filenya tidak akan berubah setelah build.
#   2. max_accelerated_files=30000 → default 10000. Proyek ini punya ~700 file
#      di vendor + app; sekali lewat batas, opcache diam-diam mulai TIDAK
#      meng-cache file baru (tidak ada error, hanya melambat).
#   3. JIT dimatikan. FrankenPHP menjalankan banyak request lewat thread,
#      dan JIT di ZTS dikenal tidak stabil — nilainya di sini nol karena
#      bottleneck-nya I/O ke database, bukan CPU.
# Ukurannya dinaikkan ke 256MB karena image ini 512MB-class dan menyisakan
# ruang untuk compiled views (60+ blade).
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.memory_consumption=256'; \
        echo 'opcache.interned_strings_buffer=32'; \
        echo 'opcache.max_accelerated_files=30000'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.jit=disable'; \
        echo 'opcache.jit_buffer_size=0'; \
    } > /usr/local/etc/php/conf.d/opcache-production.ini

WORKDIR /app

# ============================================================
# Dependencies — composer memakai PHP & extension yang sama seperti runtime
# ============================================================
FROM base AS dependencies

# Composer ikut di image ini (bukan stage terpisah) supaya install berjalan di
# atas PHP 8.4 + pdo_pgsql + intl yang sama persis dengan runtime. Kalau memakai
# image composer:2, versi PHP-nya bisa berbeda sehingga pemeriksaan platform
# composer bisa gagal, padahal kebutuhan sistemnya sebenarnya sudah terpenuhi.
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Manifest lebih dulu supaya layer dependency tidak ter-invalidasi tiap kali
# source aplikasi berubah.
COPY composer.json composer.lock ./

# --no-scripts: lewati @php artisan package:discover. Ia butuh aplikasi utuh,
# jadi dijalankan ulang di bawah setelah source disalin.
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

COPY . .

# composer dump-autoload memicu post-autoload-dump, yaitu package:discover —
# inilah yang membuat stage ini tidak perlu APP_KEY apa pun, karena config
# sengaja tidak di-cache sehingga env baru terbaca saat runtime.
# Manifest hasil generate di mesin lokal (packages.php / services.php) TIDAK
# boleh dipakai di image. packages.php mendaftarkan provider paket yang terpasang
# di mesin itu — termasuk yang hanya require-dev seperti laravel/pail. Karena
# vendor di image di-install --no-dev, kelas itu tidak ada, dan package:discover
# gagal saat memuat manifest basi:
#   "Class Laravel\Pail\PailServiceProvider not found".
# Manifest di-regenerate sendiri di baris bawah, jadi menghapusnya di sini aman
# dan membuat build tidak bergantung pada apa pun yang tertinggal di lokal.
RUN mkdir -p \
        bootstrap/cache \
        storage/app/public/avatars \
        storage/app/public/attachments \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
    && rm -f bootstrap/cache/*.php \
    && composer dump-autoload --no-dev --optimize --no-interaction

# Cache yang TIDAK bergantung pada env runtime — aman di-baked ke image.
# config:cache sengaja TIDAK ikut: Vercel menyuntikkan APP_KEY & kredensial DB
# saat container start, bukan saat build.
RUN php artisan event:cache --ansi \
 && php artisan route:cache --ansi \
 && php artisan view:cache --ansi

# ============================================================
# Runtime
# ============================================================
FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

# CAP_NET_BIND_SERVICE mengizinkan proses non-root mengikat port < 1024, jadi
# image bisa jalan sebagai www-data sekaligus tetap sinkron dengan PORT=80.
# /config & /data adalah XDG_CONFIG_HOME / XDG_DATA_HOME milik Caddy.
RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && mkdir -p /config/caddy /data/caddy \
    && chown -R www-data:www-data /config/caddy /data/caddy

# Default produksi. Env dari Vercel mengoverride nilai-nilai ini, jadi aman
# meski lupa menyetel APP_DEBUG lewat dashboard.
#
# SESSION_DRIVER=cookie (TAHAP C): session database = 2 round-trip ke Neon per
# request hanya untuk payload yang muat di cookie (~160 ms dari Jakarta).
# Cookie aman untuk multi-instance Vercel dan tidak butuh tabel sessions.
#
# SESSION_SECURE_COOKIE=true sebagai default, bukan sekadar anjuran di docs:
# cookie sesi yang tidak ditandai Secure bisa dikirim lewat koneksi http:// dan
# dicuri di jaringan. Menyetelnya di dashboard tapi/default di sini berarti
# deploy tanpa env lengkap tetap aman.
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    APP_RUNTIME=FrankenPHP \
    APP_TIMEZONE=Asia/Jakarta \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=warning \
    CACHE_STORE=database \
    SESSION_DRIVER=cookie \
    SESSION_SECURE_COOKIE=true \
    SESSION_HTTP_ONLY=true \
    SESSION_SAME_SITE=lax \
    TRUSTED_PROXIES=* \
    QUEUE_CONNECTION=database

# Catatan untuk yang mengedit: TRUSTED_PROXIES sengaja ditulis TANPA tanda kutip.
# Nilai yang dibutuhkan persis `*`, karena bootstrap/app.php membandingkan
# $trusted === '*' sebelum mem-parse jadi daftar IP. Kalau Docker menyimpan
# kutipnya, nilainya jadi literal '*' (tiga karakter) dan trustProxies()
# menerima satu "IP" yang tidak pernah match — proxy jadi tidak dipercaya tanpa
# error. ENV tidak melewati shell, jadi `*` polos aman dari globbing.

# public/storage → storage/app/public.
#
# Tanpa symlink ini, Storage::disk('public')->url() tetap menghasilkan
# /storage/avatars/… (URL-nya benar), tapi file di belakang URL itu tidak ada
# karena .dockerignore mengecualikan /public/storage dari build context. Gejalanya
# avatar rusak: HTML-nya valid, request-nya 404. Tidak ada error di log aplikasi.
#
# Dibuat sebagai symlink, bukan `php artisan storage:link`, supaya tidak
# bergantung pada artisan yang butuh env runtime (dan tidak gagal di build saat
# APP_KEY belum disuntikkan).
# chown -h (bukan -R): target /app/storage/app/public sudah milik www-data dari
# `COPY --chown` di atas; yang perlu di-chown hanya symlink-nya sendiri, karena
# `ln` di RUN ini dijalankan sebagai root.
RUN ln -sfn /app/storage/app/public /app/public/storage \
    && chown -h www-data:www-data /app/public/storage

USER www-data

# Healthcheck memakai /up milik Laravel, bukan admin API Caddy, supaya status
# mencerminkan boot aplikasi + koneksi database. Dicek dengan PHP (pasti ada)
# alih-alih curl (tidak dijamin ada di varian bookworm).
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD php -r 'exit(@file_get_contents("http://127.0.0.1:".(getenv("PORT") ?: "80")."/up") !== false ? 0 : 1);' || exit 1

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]

# PENTING — penyimpanan bersifat efemera:
#   Filesystem container di-reset setiap deploy. Foto profil (storage/app/
#   public/avatars) dan lampiran aset (…/attachments) akan HILANG setiap kali
#   ada deployment baru. Solusinya di docs/deployment.md §10.4 — pakai object
#   storage (FILESYSTEM_DISK=s3 / Vercel Blob), jangan andalkan filesystem lokal.
